  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n vite,electron \"vite --config vite.config.ts\" \"pnpm electron:dev:main\"",
    "electron:dev:main": "pnpm electron:compile && wait-on tcp:5173 -t 60000 && pnpm electron:rebuild && NODE_ENV=development PORT=5173 ELECTRON_RUN_AS_NODE= electron .",
    "electron:rebuild": "node scripts/rebuild-better-sqlite3.js",
    "build": "pnpm electron:compile && vite build --config vite.config.ts && electron-builder",
    "build:mac": "pnpm build -- --mac",
    "build:win": "pnpm build -- --win",
    "build:linux": "pnpm build -- --linux",
    "preview": "vite preview --config vite.config.ts",
    "electron:compile": "node scripts/build-electron.mjs",
    "electron:start": "ELECTRON_RUN_AS_NODE= electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:seed": "dotenv -- tsx scripts/seed-test-users.ts",
    "test:e2e:clean": "dotenv -- tsx scripts/cleanup-all-test-data.ts",
    "lint": "biome lint",
    "lint:fix": "biome lint --write --unsafe",
    "format": "biome format --write",
    "check-types": "tsc --noEmit",
    "initial:env": "tsx scripts/initial-env.ts",
    "openai-compatiable:init": "tsx scripts/init-openai-compatiable.ts",
    "openai-compatiable:parse": "tsx scripts/parse-openai-compatiable.ts",
    "postinstall": "tsx scripts/postinstall.ts",
    "clean": "tsx scripts/clean.ts",
    "clean:out": "tsx scripts/clean.ts out",
    "db:generate": "drizzle-kit generate",
    "db:reset": "drizzle-kit drop && drizzle-kit push",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:pull": "drizzle-kit pull",
    "db:check": "drizzle-kit check",
    "verify:production": "tsx scripts/verify-production-cli.ts",
    "prepare": "husky",
    "playwright:install": "playwright install",
    "check": "pnpm lint:fix && pnpm check-types && pnpm test"
  },
