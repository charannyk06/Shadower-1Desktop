<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Allow the app to be run on macOS -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow network connections (for API calls) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Allow network server (for local development server) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Allow file read access (for user documents) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow read/write to app data directory -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Allow spawning child processes (for local sandbox/terminal) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow JIT compilation (for V8/Node.js) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow dylib loading (for native modules) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Allow debugging (for development) -->
    <key>com.apple.security.get-task-allow</key>
    <true/>

    <!-- Allow automation (for browser control) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
